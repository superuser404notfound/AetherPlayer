    "Files you open appear here." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zde se zobrazí soubory, které otevřete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer, du åbner, vises her."
