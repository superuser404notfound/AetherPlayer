    "No audio: this source's audio could not be decoded, the video plays silently." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez zvuku: zvuk tohoto zdroje se nepodařilo dekódovat, video se přehrává beze zvuku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen lyd: kildens lyd kunne ikke afkodes, videoen afspilles uden lyd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Ton: Der Ton dieser Quelle konnte nicht decodiert werden, das Video wird ohne Ton wiedergegeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς ήχο: ο ήχος αυτής της πηγής δεν μπόρεσε να αποκωδικοποιηθεί, το βίντεο παίζει χωρίς ήχο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin audio: no se pudo decodificar el audio de esta fuente, el vídeo se reproduce sin sonido."
