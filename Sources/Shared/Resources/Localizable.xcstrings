        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke åpne %@: filen kan ha blitt flyttet eller slettet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan %@ niet openen: het bestand is mogelijk verplaatst of verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
