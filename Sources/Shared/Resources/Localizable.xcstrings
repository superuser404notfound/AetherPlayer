        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei ääntä: tämän lähteen ääntä ei voitu dekoodata, video toistetaan äänettömänä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de son : l’audio de cette source n’a pas pu être décodé, la vidéo est lue sans son."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema zvuka: zvuk ovog izvora nije moguće dekodirati, video se reproducira bez zvuka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs hang: a forrás hangját nem sikerült dekódolni, a videó hang nélkül játszódik le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun audio: non è stato possibile decodificare l’audio di questa sorgente, il video viene riprodotto senza audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオなし：このソースのオーディオをデコードできなかったため、ビデオは無音で再生されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오 없음: 이 소스의 오디오를 디코딩할 수 없어 비디오가 소리 없이 재생됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen lyd: lyden i denne kilden kunne ikke dekodes, videoen spilles av uten lyd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen audio: de audio van deze bron kon niet worden gedecodeerd, de video wordt zonder geluid afgespeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak dźwięku: nie udało się zdekodować dźwięku tego źródła, wideo jest odtwarzane bez dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem áudio: não foi possível decodificar o áudio desta fonte, o vídeo é reproduzido sem som."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem áudio: não foi possível descodificar o áudio desta origem, o vídeo é reproduzido sem som."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fără sunet: sunetul acestei surse nu a putut fi decodat, videoclipul se redă fără sunet."
