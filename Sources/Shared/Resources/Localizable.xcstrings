    "Could not open %@: the file may have moved or been deleted." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor %@ se nepodařilo otevřít: možná byl přesunut nebo smazán."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke åbne %@: filen er muligvis flyttet eller slettet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte nicht geöffnet werden. Die Datei wurde möglicherweise verschoben oder gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατό το άνοιγμα του %@: το αρχείο μπορεί να μετακινήθηκε ή να διαγράφηκε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir %@: puede que el archivo se haya movido o eliminado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaaminen epäonnistui: %@. Tiedosto on voitu siirtää tai poistaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir %@ : le fichier a peut-être été déplacé ou supprimé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće otvoriti %@: datoteka je možda premještena ili izbrisana."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem nyitható meg: %@. A fájl talán át lett helyezve vagy törölve lett."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire %@: il file potrebbe essere stato spostato o eliminato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を開けませんでした。ファイルが移動または削除された可能性があります。"
