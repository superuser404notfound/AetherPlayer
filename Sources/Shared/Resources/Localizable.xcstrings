    "Draws ASS/SSA tracks with the fonts, colors and placement they ship with. Turn it off to show them as plain text in the style above." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykreslí stopy ASS/SSA s písmy, barvami a umístěním, které obsahují. Po vypnutí se zobrazí jako prostý text ve stylu výše."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser ASS/SSA-spor med de skrifttyper, farver og placeringer, de leveres med. Slå det fra for at vise dem som almindelig tekst i stilen ovenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt ASS/SSA-Spuren mit den Schriften, Farben und Positionen, die sie mitbringen. Ausgeschaltet erscheinen sie als einfacher Text im Stil oben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζει τα κομμάτια ASS/SSA με τις γραμματοσειρές, τα χρώματα και τη θέση που περιέχουν. Απενεργοποιήστε το για να εμφανίζονται ως απλό κείμενο με το παραπάνω στυλ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra las pistas ASS/SSA con las fuentes, colores y posiciones que traen. Desactívalo para verlas como texto sin formato con el estilo de arriba."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää ASS/SSA-raidat niiden omilla fonteilla, väreillä ja sijainneilla. Kun asetus on pois, ne näytetään tavallisena tekstinä yllä olevalla tyylillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche les pistes ASS/SSA avec les polices, couleurs et positions qu’elles contiennent. Désactivez l’option pour les afficher en texte brut avec le style ci-dessus."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazuje ASS/SSA zapise s fontovima, bojama i položajem koje sadrže. Isključite za prikaz kao običan tekst u gornjem stilu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ASS/SSA sávokat a bennük szereplő betűtípusokkal, színekkel és elhelyezéssel jeleníti meg. Kikapcsolva egyszerű szövegként jelennek meg a fenti stílusban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra le tracce ASS/SSA con i font, i colori e le posizioni che contengono. Disattivalo per mostrarle come testo semplice con lo stile qui sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ASS/SSAトラックを、含まれているフォント、色、配置で表示します。オフにすると、上のスタイルのプレーンテキストとして表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ASS/SSA 트랙을 포함된 글꼴, 색상, 위치로 표시합니다. 끄면 위의 스타일로 일반 텍스트로 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser ASS/SSA-spor med skriftene, fargene og plasseringen de leveres med. Slå av for å vise dem som ren tekst i stilen over."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont ASS/SSA-sporen met de lettertypen, kleuren en posities die ze meebrengen. Schakel uit om ze als platte tekst in de stijl hierboven te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetla ścieżki ASS/SSA z dołączonymi czcionkami, kolorami i rozmieszczeniem. Po wyłączeniu są pokazywane jako zwykły tekst w stylu powyżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra faixas ASS/SSA com as fontes, cores e posições que elas trazem. Desative para mostrá-las como texto simples no estilo acima."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra as faixas ASS/SSA com os tipos de letra, cores e posições que trazem. Desative para as mostrar como texto simples no estilo acima."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează pistele ASS/SSA cu fonturile, culorile și pozițiile pe care le conțin. Dezactivează pentru a le afișa ca text simplu în stilul de mai sus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает дорожки ASS/SSA с их собственными шрифтами, цветами и расположением. Если выключить, они отображаются обычным текстом в стиле выше."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykreslí stopy ASS/SSA s písmami, farbami a umiestnením, ktoré obsahujú. Po vypnutí sa zobrazia ako obyčajný text v štýle vyššie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar ASS/SSA-spår med de typsnitt, färger och placeringar de levereras med. Stäng av för att visa dem som vanlig text i stilen ovan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ASS/SSA parçalarını içerdikleri yazı tipleri, renkler ve konumlarla gösterir. Kapatıldığında yukarıdaki stilde düz metin olarak görünürler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує доріжки ASS/SSA з їхніми власними шрифтами, кольорами та розташуванням. Якщо вимкнути, вони відображаються звичайним текстом у стилі вище."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 ASS/SSA 轨道自带的字体、颜色和位置显示。关闭后,以上方样式的纯文本显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依 ASS/SSA 音軌內附的字體、顏色和位置顯示。關閉後,以上方樣式的純文字顯示。"
          }
        }
      }
    },
